{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "envol",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-07",
  "account_id": "6e243906ff257b965bcae8025c2fc344",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "envol",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "envol-artifacts" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "envol.jdx.dev", "custom_domain": true }],
  "vars": { "ENVOL_URL": "https://envol.jdx.dev" },
}
